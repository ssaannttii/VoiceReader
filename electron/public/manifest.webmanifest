{
  "name": "Reader",
  "short_name": "Reader",
  "description": "Listen to articles, books and documents in VoiceStudio voices.",
  "id": "/#/reader",
  "start_url": "/#/reader",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "share_target": {
    "action": "/reader-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/epub+zip",
            ".epub",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "text/*",
            ".txt",
            ".md",
            ".html",
            "image/*"
          ]
        }
      ]
    }
  },
  "icons": [
    { "src": "/reader-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/reader-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/reader-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/reader-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "/reader-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
